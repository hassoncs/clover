{
  "version": 1,
  "project": "slopcade",
  "services": {
    "game-inspector": {
      "cwd": "packages/game-inspector-mcp",
      "command": "pnpm build && node dist/index.js",
      "health": { "type": "port", "port": 3100 }
    },
    "game-inspector-tsc": {
      "cwd": "packages/game-inspector-mcp",
      "command": "pnpm build && tsc --watch --preserveWatchOutput"
    },
    "games-server": {
      "cwd": "games",
      "command": "pnpm serve",
      "health": { "type": "port", "port": 3847 }
    },
    "api": {
      "cwd": ".",
      "command": "CLOUDFLARE_INCLUDE_PROCESS_ENV=true npx hush run -t api-workers -- pnpm --filter @slopcade/api dev",
      "health": { "type": "port", "port": 8789 },
      "dependsOn": ["games-server"]
    },
    "godot": {
      "cwd": ".",
      "command": "node scripts/export-godot.mjs --watch"
    },
    "registry": {
      "cwd": "app",
      "command": "npx reggie --watch"
    },
    "metro": {
      "cwd": "app",
      "command": "node ../scripts/export-godot.mjs --once && RCT_METRO_PORT=8085 npx hush run -t app -- npx expo start --dev-client --port 8085",
      "health": { "type": "port", "port": 8085 },
      "dependsOn": ["api", "godot", "registry", "game-inspector", "game-inspector-tsc"]
    },
    "web": {
      "cwd": "app",
      "command": "node ../scripts/export-godot.mjs --once && npx hush run -t app -- npx expo start --web --port 8085",
      "health": { "type": "port", "port": 8085 },
      "dependsOn": ["api", "godot", "registry", "game-inspector", "game-inspector-tsc"]
    },
    "storybook": {
      "cwd": "apps/storybook",
      "command": "npx hush run -t app -- pnpm storybook",
      "health": { "type": "port", "port": 6006 }
    }
  }
}
