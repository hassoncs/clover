{
	"$schema": "https://opencode.ai/config.json",
	"permission": {
		"read": {
			"*": "allow"
		}
	},
	"mcp": {
		"backlog": {
			"type": "local",
			"command": ["node_modules/.bin/backlog", "mcp", "start"]
		},
		"mcp-hot-ops": {
			"type": "local",
			"command": ["node_modules/.bin/tsx", "packages/mcp-hot-ops/src/server.ts"]
		},
		"game-inspector": {
			"type": "local",
			"command": ["node", "packages/game-inspector-mcp/dist/index.js"]
		}
	}
}
