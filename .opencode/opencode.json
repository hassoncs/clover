{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow"
    }
  },
  "mcp": {
    "backlog": {
      "type": "local",
      "command": ["node_modules/.bin/backlog", "mcp", "start"]
    },
    "game-inspector": {
      "type": "local",
      "command": ["node", "packages/game-inspector-mcp/dist/index.js"]
    }
  }
}
