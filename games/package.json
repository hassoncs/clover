{
  "name": "@slopcade/games",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "serve": "tsx scripts/serve.ts",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./registry": "./src/registry.ts",
    "./static": "./dist/static-registry.ts",
    "./compiled/*": "./compiled/*/game.ts"
  },
  "dependencies": {
    "@slopcade/game-bundler": "workspace:*",
    "@slopcade/shared": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
