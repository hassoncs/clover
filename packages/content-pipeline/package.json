{
	"name": "@slopcade/content-pipeline",
	"version": "0.1.0",
	"description": "Standalone content generation pipeline for party games",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"content-pipeline": "./dist/cli.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"cli": "node dist/cli.js"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.32.1",
		"better-sqlite3": "^11.8.1",
		"yargs": "^17.7.2",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "^20.0.0",
		"@types/yargs": "^17.0.33",
		"typescript": "~5.9.3",
		"vitest": "^2.1.9"
	},
	"engines": {
		"node": ">=18"
	}
}
