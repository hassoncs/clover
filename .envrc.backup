# Add local node_modules bin to PATH for hush and other CLI tools
PATH_add node_modules/.bin

# Add devmux to PATH if it exists
if [ -d "$PWD/devmux" ]; then
    PATH_add devmux
fi

# Add any local scripts directory
if [ -d "$PWD/scripts" ]; then
    PATH_add scripts
fi

