{
	"mcpServers": {
		"backlog": {
			"command": "node_modules/.bin/backlog",
			"args": ["mcp", "start"]
		},
		"game-inspector": {
			"command": "node",
			"args": ["packages/game-inspector-mcp/dist/index.js"]
		},
		"slopcade-api": {
			"command": "npx",
			"args": ["mcp-remote", "http://api.slopcade.localhost:1355/mcp"]
		}
	}
}
