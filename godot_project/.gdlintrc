# GDScript Linting Configuration
# Relaxed rules for legacy code

# Allow larger files and methods for legacy bridge code
max-file-lines: 3000
max-public-methods: 150
max-line-length: 140

# Disable checks for legacy code patterns
disable:
  - class-definitions-order
  - unused-argument
  - no-elif-return
  - no-else-return
