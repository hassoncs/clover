[configuration]

entry_symbol = "camera_texture_init"
compatibility_minimum = 4.3

[libraries]

macos.debug = "bin/macos/libcamera_texture.macos.template_debug.dylib"
macos.release = "bin/macos/libcamera_texture.macos.template_release.dylib"
ios.debug.arm64 = "bin/ios/libcamera_texture.ios.template_debug.arm64.dylib"
ios.release.arm64 = "bin/ios/libcamera_texture.ios.template_release.arm64.dylib"
