extends Node

signal game_loaded(game_data: Dictionary)
signal entity_spawned(entity_id: String, node: Node2D)
signal entity_destroyed(entity_id: String)
signal collision_occurred(entity_a: String, entity_b: String, impulse: float)
signal query_result(request_id: int, result: Variant)
signal joint_created(request_id: int, joint_id: int)

# ============================================================================
# MODULE INSTANCES
# ============================================================================
var _entity_manager: EntityManager = null
var _entity_factory: EntityFactory = null
var _physics_controller: PhysicsController = null
var _transform_system: TransformSystem = null
var _visual_renderer: VisualRenderer = null
var _joint_manager: JointManager = null
var _event_emitter: EventEmitter = null
var _sync_system: SyncSystem = null
var _camera_controller: CameraController = null
var _ui_manager: UIManager = null
var _physics_queries: PhysicsQueries = null
var _debug_bridge: DebugBridge = null
var _viewport_3d: Viewport3D = null
var _query_system: QuerySystem = null
var _event_queue_module: EventQueue = null
var _glb_loader: GLBLoader = null
var _property_collector: PropertyCollector = null
var _devtools_overlay: DebugOverlay = null

# ============================================================================
# CORE STATE (kept in orchestrator for coordination)
# ============================================================================
var game_data: Dictionary = {}
var entities: Dictionary = {}
var templates: Dictionary = {}
var pixels_per_meter: float = 50.0
var game_root: Node2D = null
var camera: Camera2D = null

var _js_bridge_obj: JavaScriptObject = null
var _js_callbacks: Array = []

var ws: WebSocketPeer = null
var ws_url: String = "ws://localhost:8789"

var _texture_cache: Dictionary = {}
var _pending_textures: Array = []
var _audio_cache: Dictionary = {}

# Joint management
var joints: Dictionary = {}
var joint_counter: int = 0

# Sensor management
var sensors: Dictionary = {}
var sensor_velocities: Dictionary = {}

# Collision tracking
var _active_contacts: Dictionary = {}
const IMPULSE_THRESHOLD: float = 0.01

# UI Button management
var _ui_buttons: Dictionary = {}

# Splat Map System
var _splat_enabled: bool = false
var _splat_viewport: SubViewport = null
var _splat_canvas: CanvasLayer = null
var _splat_proxies: Dictionary = {}
const SPLAT_PROXY_SCENE = preload("res://scenes/SplatProxy.tscn")

# Debug mode
var _debug_show_shapes: bool = false

# Body ID tracking
var body_id_map: Dictionary = {}
var body_id_reverse: Dictionary = {}
var next_body_id: int = 1

# Collider ID tracking
var collider_id_map: Dictionary = {}
var next_collider_id: int = 1

# User data storage
var user_data: Dictionary = {}
var body_groups: Dictionary = {}

# Shape index mapping
var entity_shape_map: Dictionary = {}

# Camera control
var camera_target_id: String = ""
var camera_smoothing: float = 5.0

# Background management
var _background_layer: CanvasLayer = null
var _background_rect: TextureRect = null
var _parallax_layers: Array = []

# Event queue
var _event_queue: Array = []
const MAX_EVENT_QUEUE_SIZE: int = 100

# Drag tracking
var _is_dragging: bool = false
var _drag_entity_id: Variant = null
var _drag_start_pos: Vector2 = Vector2.ZERO
var _drag_start_time: float = 0.0
const TAP_MAX_DISTANCE: float = 10.0
const TAP_MAX_DURATION: float = 0.3

# ============================================================================
# COORDINATE CONVERSION
# ============================================================================
func game_to_godot_pos(game_pos: Vector2) -> Vector2:
	return Vector2(game_pos.x * pixels_per_meter, -game_pos.y * pixels_per_meter)

func godot_to_game_pos(godot_pos: Vector2) -> Vector2:
	return Vector2(godot_pos.x / pixels_per_meter, -godot_pos.y / pixels_per_meter)

func game_to_godot_vec(game_vec: Vector2) -> Vector2:
	return Vector2(game_vec.x * pixels_per_meter, -game_vec.y * pixels_per_meter)

func godot_to_game_vec(godot_vec: Vector2) -> Vector2:
	return Vector2(godot_vec.x / pixels_per_meter, -godot_vec.y / pixels_per_meter)

# ============================================================================
# LIFECYCLE
# ============================================================================
func _ready() -> void:
	_init_modules()
	_setup_camera()
	_setup_js_bridge()

func _init_modules() -> void:
	_event_queue_module = EventQueue.new()
	_entity_manager = EntityManager.new(self)
	_entity_factory = EntityFactory.new(self)
	_physics_controller = PhysicsController.new(self)
	_transform_system = TransformSystem.new(self)
	_visual_renderer = VisualRenderer.new(self)
	_joint_manager = JointManager.new(self)
	_event_emitter = EventEmitter.new(self)
	_sync_system = SyncSystem.new(self)
	_camera_controller = CameraController.new(self)
	_ui_manager = UIManager.new(self)
	_physics_queries = PhysicsQueries.new(self)
	_glb_loader = GLBLoader.new(self)
	_property_collector = PropertyCollector.new(self)
	_query_system = QuerySystem.new()
	
	_viewport_3d = Viewport3D.new()
	_viewport_3d.name = "Viewport3D"
	_viewport_3d.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_viewport_3d)
	
	_debug_bridge = DebugBridge.new(self, _query_system)
	
	_devtools_overlay = DebugOverlay.new()
	_devtools_overlay.setup(self)
	_devtools_overlay.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_devtools_overlay)
	
	_register_core_query_handlers()

func _register_core_query_handlers() -> void:
	_query_system.register_handler("getAllTransforms", func(args): return get_all_transforms())
	_query_system.register_handler("getAllProperties", func(args): return collect_all_properties())
	_query_system.register_handler("getWorldInfo", func(args): return get_world_info())
	_query_system.register_handler("getCameraInfo", func(args): return get_camera_info())
	_query_system.register_handler("getViewportInfo", func(args): return get_viewport_info())
	_query_system.register_handler(
		"getEntityTransform",
		func(args):
			if args.size() > 0:
				return _get_entity_transform_impl(str(args[0]))
			return null
	)
	_query_system.register_handler(
		"queryPointEntity",
		func(args):
			if args.size() >= 2:
				return _physics_queries.query_point_entity(float(args[0]), float(args[1]))
			return null
	)
	_query_system.register_handler(
		"screenToWorld",
		func(args):
			if args.size() >= 2:
				return _screen_to_world_impl(float(args[0]), float(args[1]))
			return null
	)
	_query_system.register_handler("getSplatTexture", func(args): return get_splat_texture())

func _setup_camera() -> void:
	camera = Camera2D.new()
	camera.name = "GameCamera"
	camera.enabled = true
	camera.global_position = Vector2.ZERO
	add_child(camera)
	camera.make_current()

# ============================================================================
# JS BRIDGE SETUP
# ============================================================================
func _setup_js_bridge() -> void:
	if not OS.has_feature("web"):
		return

	var window = JavaScriptBridge.get_interface("window")
	if window == null:
		return

	_js_bridge_obj = JavaScriptBridge.create_object("Object")

	var handlers = [
		# Core game management (stay in orchestrator)
		["loadGameJson", "_js_load_game"],
		["clearGame", "_js_clear_game"],
		["setInspectMode", "_js_set_inspect_mode"],
		["pausePhysics", "_js_pause_physics"],
		["resumePhysics", "_js_resume_physics"],
		["loadCustomScene", "_js_load_custom_scene"],
		
		# Entity operations -> EntityManager
		["spawnEntity", "_js_spawn_entity"],
		["destroyEntity", "_js_destroy_entity"],
		["getEntityTransform", "_js_get_entity_transform"],
		["getAllTransforms", "_js_get_all_transforms"],
		["getAllProperties", "_js_get_all_properties"],
		
		# Transform operations -> TransformSystem
		["onTransformSync", "_js_on_transform_sync"],
		["getTransform", "_js_get_transform"],
		["getTransforms", "_js_get_transforms"],
		
		# Sync operations -> SyncSystem
		["onPropertySync", "_js_on_property_sync"],
		["setWatchConfig", "_js_set_watch_config"],
		["setTrackedEntities", "_js_set_tracked_entities"],
		
		# Physics operations -> PhysicsController
		["setLinearVelocity", "_js_set_linear_velocity"],
		["setAngularVelocity", "_js_set_angular_velocity"],
		["applyImpulse", "_js_apply_impulse"],
		["applyForce", "_js_apply_force"],
		["applyTorque", "_js_apply_torque"],
		
		# Input/collision events (stay in orchestrator, use EventEmitter for callbacks)
		["sendInput", "_js_send_input"],
		["onInputEvent", "_js_on_input_event"],
		["onCollision", "_js_on_collision"],
		["onEntityDestroyed", "_js_on_entity_destroyed"],
		["onSensorBegin", "_js_on_sensor_begin"],
		["onSensorEnd", "_js_on_sensor_end"],
		
		# Body API -> EntityFactory
		["createBody", "_js_create_body"],
		["addFixture", "_js_add_fixture"],
		["setSensor", "_js_set_sensor"],
		["setUserData", "_js_set_user_data"],
		["getUserData", "_js_get_user_data"],
		["getAllBodies", "_js_get_all_bodies"],
		
		# Visual operations -> VisualRenderer
		["setEntityImage", "_js_set_entity_image"],
		["setEntityAtlasRegion", "_js_set_entity_atlas_region"],
		["clearTextureCache", "_js_clear_texture_cache"],
		["preloadTextures", "_js_preload_textures"],
		["setDebugShowShapes", "_js_set_debug_show_shapes"],
		["setDebugSettings", "_js_set_debug_settings"],
		
		# Camera operations -> CameraController
		["setCameraTarget", "_js_set_camera_target"],
		["setCameraPosition", "_js_set_camera_position"],
		["setCameraZoom", "_js_set_camera_zoom"],
		
		# UI operations -> UIManager
		["spawnParticle", "_js_spawn_particle"],
		["playSound", "_js_play_sound"],
		["createUIButton", "_js_create_ui_button"],
		["destroyUIButton", "_js_destroy_ui_button"],
		["onUIButtonEvent", "_js_on_ui_button_event"],
		
		# 3D Viewport operations -> Viewport3D
		["show_3d_model", "_js_show_3d_model"],
		["show_3d_model_from_url", "_js_show_3d_model_from_url"],
		["set_3d_viewport_position", "_js_set_3d_viewport_position"],
		["set_3d_viewport_size", "_js_set_3d_viewport_size"],
		["rotate_3d_model", "_js_rotate_3d_model"],
		["set_3d_camera_distance", "_js_set_3d_camera_distance"],
		["clear_3d_models", "_js_clear_3d_models"],
		
		# Physics queries -> PhysicsQueries
		["queryPoint", "_js_query_point"],
		["queryPointEntity", "_js_query_point_entity"],
		["queryAABB", "_js_query_aabb"],
		["raycast", "_js_raycast"],
		
		# Debug info -> DebugBridge
		["captureScreenshot", "_js_capture_screenshot"],
		["getWorldInfo", "_js_get_world_info"],
		["getCameraInfo", "_js_get_camera_info"],
		["getViewportInfo", "_js_get_viewport_info"],
		
		# Joint operations -> JointManager
		["createRevoluteJoint", "_js_create_revolute_joint"],
		["createDistanceJoint", "_js_create_distance_joint"],
		["createPrismaticJoint", "_js_create_prismatic_joint"],
		["createWeldJoint", "_js_create_weld_joint"],
		["createMouseJoint", "_js_create_mouse_joint"],
		["destroyJoint", "_js_destroy_joint"],
		["setMotorSpeed", "_js_set_motor_speed"],
		["setMouseTarget", "_js_set_mouse_target"],
	]

	for handler in handlers:
		var cb = JavaScriptBridge.create_callback(Callable(self, handler[1]))
		_js_callbacks.append(cb)
		_js_bridge_obj[handler[0]] = cb

	window["GodotBridge"] = _js_bridge_obj

# ============================================================================
# CORE GAME MANAGEMENT (orchestrator responsibility)
# ============================================================================
func _js_load_game(args: Array) -> bool:
	return load_game_json(str(args[0]))

func _js_clear_game(_args: Array) -> void:
	clear_game()

func _js_set_inspect_mode(args: Array) -> void:
	set_inspect_mode(bool(args[0]))

func _js_pause_physics(_args: Array) -> void:
	pause_physics()

func _js_resume_physics(_args: Array) -> void:
	resume_physics()

func _js_load_custom_scene(args: Array) -> bool:
	return load_custom_scene(str(args[0]))

func set_inspect_mode(enabled: bool) -> void:
	if _debug_bridge:
		_debug_bridge.get_time_module().set_inspect_mode(enabled)

func pause_physics() -> void:
	Engine.time_scale = 0.0

func resume_physics() -> void:
	Engine.time_scale = 1.0

# ============================================================================
# ENTITY HANDLERS -> EntityManager
# ============================================================================
func _js_spawn_entity(args: Array) -> void:
	var template_id = str(args[0])
	var x = float(args[1])
	var y = float(args[2])
	var entity_id = str(args[3]) if args.size() > 3 else ""
	var velocity_json = str(args[4]) if args.size() > 4 else ""
	_entity_manager.spawn_entity(template_id, x, y, entity_id, velocity_json)

func _js_destroy_entity(args: Array) -> void:
	_entity_manager.destroy_entity(str(args[0]))

func _js_get_entity_transform(args: Array) -> Variant:
	var transform = _entity_manager.get_entity_transform(str(args[0]))
	_js_bridge_obj["_lastResult"] = JSON.stringify(transform) if transform else ""
	return transform

func _js_get_all_transforms(_args: Array) -> void:
	_js_bridge_obj["_lastResult"] = JSON.stringify(_entity_manager.get_all_transforms())

func _js_get_all_properties(_args: Array) -> void:
	_js_bridge_obj["_lastResult"] = JSON.stringify(collect_all_properties())

func _js_on_entity_destroyed(args: Array) -> void:
	_event_emitter.set_destroy_callback(args[0])

# ============================================================================
# TRANSFORM HANDLERS -> TransformSystem
# ============================================================================
func _js_on_transform_sync(args: Array) -> void:
	_sync_system.set_transform_sync_callback(args[0])

func _js_get_transform(args: Array) -> void:
	_js_bridge_obj["_lastResult"] = JSON.stringify(_sync_system.get_transform(str(args[0])))

func _js_get_transforms(args: Array) -> void:
	var entity_ids = JSON.parse_string(str(args[0]))
	if entity_ids is Array:
		_js_bridge_obj["_lastResult"] = JSON.stringify(_sync_system.get_transforms(entity_ids))

# ============================================================================
# SYNC HANDLERS -> SyncSystem
# ============================================================================
func _js_on_property_sync(args: Array) -> void:
	_sync_system.set_property_sync_callback(args[0])

func _js_set_watch_config(args: Array) -> void:
	var config = JSON.parse_string(str(args[0]))
	if config is Dictionary:
		_sync_system.set_watch_config(config)

func _js_set_tracked_entities(args: Array) -> void:
	var entity_ids = JSON.parse_string(str(args[0]))
	var config = JSON.parse_string(str(args[1])) if args.size() > 1 else {}
	if entity_ids is Array:
		_sync_system.set_tracked_entities(entity_ids, config if config is Dictionary else {})

