# ============================================================================
# JOINT HANDLERS -> JointManager
# ============================================================================
func _js_create_revolute_joint(args: Array) -> void:
	var config = JSON.parse_string(str(args[0])) if args.size() > 0 else {}
	if config is Dictionary:
		var joint_id = _joint_manager.create_revolute_joint(
			str(config.get("entityA", "")),
			str(config.get("entityB", "")),
			float(config.get("anchorX", 0)),
			float(config.get("anchorY", 0)),
			config
		)
		_js_bridge_obj["_lastResult"] = joint_id

func _js_create_distance_joint(args: Array) -> void:
	var config = JSON.parse_string(str(args[0])) if args.size() > 0 else {}
	if config is Dictionary:
		var joint_id = _joint_manager.create_distance_joint(
			str(config.get("entityA", "")),
			str(config.get("entityB", "")),
			float(config.get("anchorAX", 0)),
			float(config.get("anchorAY", 0)),
			config
		)
		_js_bridge_obj["_lastResult"] = joint_id

func _js_create_prismatic_joint(args: Array) -> void:
	var config = JSON.parse_string(str(args[0])) if args.size() > 0 else {}
	if config is Dictionary:
		var joint_id = _joint_manager.create_prismatic_joint(
			str(config.get("entityA", "")),
			str(config.get("entityB", "")),
			float(config.get("axisX", 0)),
			float(config.get("axisY", 1)),
			config
		)
		_js_bridge_obj["_lastResult"] = joint_id

func _js_create_weld_joint(args: Array) -> void:
	var config = JSON.parse_string(str(args[0])) if args.size() > 0 else {}
	if config is Dictionary:
		var joint_id = _joint_manager.create_weld_joint(
			str(config.get("entityA", "")),
			str(config.get("entityB", "")),
			float(config.get("anchorX", 0)),
			float(config.get("anchorY", 0)),
			config
		)
		_js_bridge_obj["_lastResult"] = joint_id

func _js_create_mouse_joint(args: Array) -> void:
	var config = JSON.parse_string(str(args[0])) if args.size() > 0 else {}
	if config is Dictionary:
		var joint_id = _joint_manager.create_mouse_joint(
			str(config.get("entityId", "")),
			float(config.get("targetX", 0)),
			float(config.get("targetY", 0)),
			config
		)
		_js_bridge_obj["_lastResult"] = joint_id

func _js_destroy_joint(args: Array) -> void:
	_joint_manager.destroy_joint(int(args[0]))

func _js_set_motor_speed(args: Array) -> void:
	_joint_manager.set_motor_speed(int(args[0]), float(args[1]))

func _js_set_mouse_target(args: Array) -> void:
	_joint_manager.set_mouse_target(int(args[0]), float(args[1]), float(args[2]))

