func get_all_transforms() -> Dictionary:
	if _entity_manager:
		return _entity_manager.get_all_transforms()
	return {}

func collect_all_properties() -> Dictionary:
	if _entity_manager:
		return _entity_manager.get_all_properties()
	return {}

func get_all_bodies() -> Array:
	var result = []
	for entity_id in body_id_map:
		result.append({
			"entityId": entity_id,
			"bodyId": body_id_map[entity_id]
		})
	return result

func get_world_info() -> Dictionary:
	return {
		"pixelsPerMeter": pixels_per_meter,
		"gravity": {"x": 0, "y": ProjectSettings.get_setting("physics/2d/default_gravity", 980) / pixels_per_meter},
		"bounds": game_data.get("world", {}).get("bounds", {"width": 14, "height": 18})
	}

func get_camera_info() -> Dictionary:
	if camera:
		var game_pos = godot_to_game_pos(camera.global_position)
		return {
			"position": {"x": game_pos.x, "y": game_pos.y},
			"zoom": camera.zoom.x,
			"target": camera_target_id
		}
	return {}

func get_viewport_info() -> Dictionary:
	var viewport = get_viewport()
	if viewport:
		var size = viewport.get_visible_rect().size
		return {
			"width": size.x,
			"height": size.y
		}
	return {"width": 1152, "height": 648}

func get_splat_texture() -> Texture2D:
	if _splat_viewport:
		return _splat_viewport.get_texture()
	return null

func _get_entity_transform_impl(entity_id: String) -> Variant:
	if _entity_manager:
		return _entity_manager.get_entity_transform(entity_id)
	return null

func _screen_to_world_impl(screen_x: float, screen_y: float) -> Dictionary:
	var viewport = get_viewport()
	if viewport and camera:
		var world_pos = camera.get_global_mouse_position()
		var game_pos = godot_to_game_pos(world_pos)
		return {"x": game_pos.x, "y": game_pos.y}
	return {"x": 0, "y": 0}
