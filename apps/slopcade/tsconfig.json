{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./*"],
			"@slopcade/app-lib": ["../../packages/app-lib/src/index.ts"],
			"@slopcade/app-lib/*": ["../../packages/app-lib/src/*"],
			"@slopcade/game-runtime": ["../../packages/game-runtime/src/index.ts"],
			"@slopcade/game-runtime/*": ["../../packages/game-runtime/src/*"],
			"@slopcade/godot-bridge": ["../../packages/godot-bridge/src/index.ts"],
			"@slopcade/godot-bridge/*": ["../../packages/godot-bridge/src/*"]
		},
		"types": ["node", "react"]
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"nativewind-env.d.ts",
		"../../types/*.d.ts"
	],
	"exclude": [
		"node_modules",
		"**/*.test.ts",
		"**/*.test.tsx",
		"**/__tests__/**",
		"jest.setup.ts",
		"vitest.setup.ts"
	]
}
