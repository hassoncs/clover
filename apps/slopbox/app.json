{
  "expo": {
    "scheme": "slopbox",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withGodotAssets",
      "./plugins/withMetroPort",
      "./plugins/withCameraFrameProcessor",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Slopbox uses your camera for game features"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#6B63FF"
        }
      ]
    ],
    "userInterfaceStyle": "dark",
    "name": "Slopbox",
    "slug": "slopbox",
    "description": "Party games — Fast. Fun. Chaotic.",
    "runtimeVersion": "1.0.0",
    "ios": {
      "bundleIdentifier": "tv.slopbox.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "tv.slopbox.app"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}
