{
	"name": "@slopcade/pencil-app",
	"version": "1.0.0",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start --port 8089",
		"dev": "expo start --port 8089",
		"dev:web": "expo start --web --port 8089",
		"session": "tsx bin/pencil-session.ts",
		"session:mcp": "tsx bin/pencil-session-mcp.ts",
		"prebuild": "npx expo prebuild --no-install --platform ios",
		"ios": "RCT_METRO_PORT=8089 expo run:ios --no-bundler",
		"android": "RCT_METRO_PORT=8089 expo run:android --no-bundler",
		"doctor": "expo doctor",
		"clean:js": "rimraf node_modules .expo .expo-shared dist web-build",
		"clean:ios": "rimraf ios/Pods ios/build ~/Library/Developer/Xcode/DerivedData",
		"clean:android": "rimraf android/.gradle android/build android/app/build",
		"clean": "pnpm run clean:js && pnpm run clean:ios && pnpm run clean:android",
		"pods": "cd ios && RCT_METRO_PORT=8089 pod install",
		"postinstall": "mkdir -p public && node -e \"const p=require.resolve('@shopify/react-native-skia');const wasm=require.resolve('canvaskit-wasm/bin/full/canvaskit.wasm',{paths:[p]});require('fs').copyFileSync(wasm,'public/canvaskit.wasm');console.log('canvaskit.wasm copied');\""
	},
	"dependencies": {
		"@expo/vector-icons": "^14.0.0",
		"@slopcade/api": "workspace:*",
		"@tanstack/react-query": "^5.90.19",
		"@trpc/client": "11.8.1",
		"@trpc/react-query": "11.8.1",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"@shopify/react-native-skia": "^2.4.14",
		"@slopcade/design-canvas": "workspace:*",
		"@slopcade/pencil-core": "workspace:*",
		"@slopcade/shared": "workspace:*",
		"@slopcade/theme": "workspace:*",
		"@slopcade/ui": "workspace:*",
		"expo": "^54.0.1",
		"expo-asset": "^12.0.12",
		"expo-constants": "^18.0.13",
		"expo-file-system": "~19.0.11",
		"expo-font": "~13.3.1",
		"expo-linking": "^8.0.8",
		"expo-router": "~6.0.0",
		"expo-splash-screen": "^31.0.13",
		"expo-status-bar": "~2.2.3",
		"nativewind": "4.2.1",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-native": "0.81.4",
		"react-native-css-interop": "0.2.1",
		"react-native-gesture-handler": "^2.30.0",
		"react-native-reanimated": "^4.1.6",
		"react-native-safe-area-context": "^5.6.1",
		"react-native-screens": "~4.16.0",
		"react-native-web": "^0.21.0",
		"react-native-worklets-core": "^1.6.2"
	},
	"private": true,
	"devDependencies": {
		"@rozenite/metro": "^1.2.0",
		"@types/node": "^25.0.9",
		"@types/react": "~19.1.17",
		"babel-plugin-transform-import-meta": "^2.3.3",
		"rimraf": "^6.0.0",
		"tailwindcss": "3.4.17",
		"typescript": "~5.9.3"
	}
}
