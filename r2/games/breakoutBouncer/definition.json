    "type": "static",
    "whatDescription": "a dark neon arcade game background"
  },
  "world": {
    "gravity": {
      "x": 0,
      "y": 0
    },
    "pixelsPerMeter": 50,
    "bounds": {
      "width": 10,
      "height": 20
    }
  },
  "camera": {
    "type": "fixed",
    "zoom": 1
  },
  "input": {
    "tapZones": [
      {
        "id": "left-zone",
