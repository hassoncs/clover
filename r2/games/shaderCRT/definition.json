  "effects": {
    "shaders": {
      "crt_screen": {
        "filename": "crt_screen.gdshader",
        "glsl": "shader_type canvas_item;\n\nuniform float scanline_count : hint_range(50.0, 800.0) = 300.0;\nuniform float scanline_intensity : hint_range(0.0, 1.0) = 0.15;\nuniform float curvature : hint_range(0.0, 0.1) = 0.03;\nuniform float vignette_intensity : hint_range(0.0, 1.0) = 0.4;\nuniform float flicker_speed : hint_range(0.0, 10.0) = 3.0;\nuniform float flicker_amount : hint_range(0.0, 0.1) = 0.02;\nuniform float chromatic_offset : hint_range(0.0, 5.0) = 1.0;\nuniform vec4 tint_color : source_color = vec4(0.9, 1.0, 0.9, 1.0);\n\nvec2 curve_uv(vec2 uv) {\n\tuv = uv * 2.0 - 1.0;\n\tvec2 offset = abs(uv.yx) / vec2(6.0, 4.0);\n\tuv = uv + uv * offset * offset * curvature;\n\tuv = uv * 0.5 + 0.5;\n\treturn uv;\n}\n\nvoid fragment() {\n\tvec2 uv = curve_uv(UV);\n\t\n\tif (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {\n\t\tCOLOR = vec4(0.0, 0.0, 0.0, 1.0);\n\t\treturn;\n\t}\n\t\n\tvec2 pixel_size = TEXTURE_PIXEL_SIZE * chromatic_offset;\n\tfloat r = texture(TEXTURE, uv + vec2(pixel_size.x, 0.0)).r;\n\tfloat g = texture(TEXTURE, uv).g;\n\tfloat b = texture(TEXTURE, uv - vec2(pixel_size.x, 0.0)).b;\n\tvec3 col = vec3(r, g, b);\n\t\n\tfloat scanline = sin(uv.y * scanline_count * 3.14159) * 0.5 + 0.5;\n\tcol *= 1.0 - scanline_intensity * (1.0 - scanline);\n\t\n\tfloat flicker = 1.0 - flicker_amount * sin(TIME * flicker_speed);\n\tcol *= flicker;\n\t\n\tfloat vignette = uv.x * uv.y * (1.0 - uv.x) * (1.0 - uv.y);\n\tvignette = clamp(pow(16.0 * vignette, vignette_intensity), 0.0, 1.0);\n\tcol *= vignette;\n\t\n\tcol *= tint_color.rgb;\n\t\n\tCOLOR = vec4(col, 1.0);\n}"
      }
    }
  }
