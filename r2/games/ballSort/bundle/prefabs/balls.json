    ],
    "whatDescription": "a small round droppable ball object",
    "visual": {
      "type": "image",
      "imageWidth": 1.2,
      "imageHeight": 1.2
    },
    "conditionalBehaviors": [
      {
        "when": {
          "hasTag": "held"
        },
        "priority": 1,
        "behaviors": [
