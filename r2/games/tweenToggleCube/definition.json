  "rules": [
    {
      "id": "toggle_cube_tween",
      "name": "Toggle cube tween on animate button tap",
      "trigger": {
        "type": "tap"
      },
      "actions": [
        {
          "type": "run_script",
          "export": "toggleCubeTween"
        }
      ]
    }
  ],
  "script": "// --- main ---\n\nexports.toggleCubeTween = function(ctx) {\n  if (ctx.isSequenceRunning('cube_toggle')) return;\n\n  var pos = ctx.getEntityPosition('cube');\n  var targetX = pos && pos.x > 0 ? -2 : 2;\n\n  ctx.startSequence('cube_toggle', async function(world) {\n    await world.animate('cube', { x: targetX, y: 1 }, { duration: 450, easing: 'ease-in-out' });\n  });\n};\n"
}