  "effects": {
    "shaders": {
      "pulse_glow": {
        "filename": "pulse_glow.gdshader",
        "glsl": "shader_type canvas_item;\n\nuniform float glow_intensity : hint_range(0.0, 3.0) = 1.5;\nuniform float pulse_speed : hint_range(0.0, 10.0) = 2.0;\nuniform vec4 glow_color : source_color = vec4(0.3, 0.6, 1.0, 1.0);\n\nvoid fragment() {\n\tvec4 tex = texture(TEXTURE, UV);\n\tfloat pulse = (sin(TIME * pulse_speed) * 0.5 + 0.5) * glow_intensity;\n\tvec3 glow = glow_color.rgb * pulse;\n\tCOLOR = vec4(tex.rgb + glow * tex.a, tex.a);\n}"
      },
      "dissolve": {
        "filename": "dissolve.gdshader",
        "glsl": "shader_type canvas_item;\n\nuniform float dissolve_amount : hint_range(0.0, 1.0) = 0.0;\nuniform float edge_width : hint_range(0.0, 0.2) = 0.05;\nuniform vec4 edge_color : source_color = vec4(1.0, 0.5, 0.0, 1.0);\nuniform float noise_scale : hint_range(1.0, 20.0) = 8.0;\n\nfloat hash(vec2 p) {\n\treturn fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\n}\n\nfloat noise(vec2 p) {\n\tvec2 i = floor(p);\n\tvec2 f = fract(p);\n\tf = f * f * (3.0 - 2.0 * f);\n\tfloat a = hash(i);\n\tfloat b = hash(i + vec2(1.0, 0.0));\n\tfloat c = hash(i + vec2(0.0, 1.0));\n\tfloat d = hash(i + vec2(1.0, 1.0));\n\treturn mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\nvoid fragment() {\n\tvec4 tex = texture(TEXTURE, UV);\n\tfloat n = noise(UV * noise_scale);\n\tfloat dissolve_val = (sin(TIME * 0.8) * 0.5 + 0.5);\n\tfloat alpha = step(dissolve_val, n);\n\tfloat edge = step(dissolve_val - edge_width, n) - alpha;\n\tvec3 col = mix(tex.rgb, edge_color.rgb, edge);\n\tCOLOR = vec4(col, tex.a * alpha + edge * tex.a);\n}"
      },
      "holographic": {
        "filename": "holographic.gdshader",
        "glsl": "shader_type canvas_item;\n\nuniform float scan_speed : hint_range(0.0, 5.0) = 1.0;\nuniform float scan_line_count : hint_range(10.0, 100.0) = 40.0;\nuniform float color_shift_speed : hint_range(0.0, 5.0) = 0.5;\nuniform float hologram_alpha : hint_range(0.0, 1.0) = 0.8;\n\nvec3 hsv2rgb(vec3 c) {\n\tvec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);\n\tvec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);\n\treturn c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);\n}\n\nvoid fragment() {\n\tvec4 tex = texture(TEXTURE, UV);\n\tfloat scan = sin((UV.y + TIME * scan_speed) * scan_line_count * 3.14159) * 0.5 + 0.5;\n\tfloat hue = fract(UV.y * 0.5 + TIME * color_shift_speed);\n\tvec3 holo_color = hsv2rgb(vec3(hue, 0.7, 1.0));\n\tvec3 result = mix(tex.rgb, holo_color, 0.6) * (0.8 + 0.2 * scan);\n\tCOLOR = vec4(result, tex.a * hologram_alpha);\n}"
      }
    }
  }
