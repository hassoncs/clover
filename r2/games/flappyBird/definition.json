  "persistence": {
    "storageKey": "flappy-bird-progress",
    "schema": {
      "_def": {
        "unknownKeys": "strip",
        "catchall": {
          "_def": {
            "typeName": "ZodNever"
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodObject"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      },
      "_cached": null
    },
    "version": 1,
    "defaultProgress": {
      "version": 1,
      "highScore": 0,
      "gamesPlayed": 0,
      "totalPipesPassed": 0,
      "bestStreak": 0,
      "unlockedBirds": [
        "default"
      ],
      "totalPlayTime": 0,
      "sessionsCompleted": 0
    },
    "autoSave": {
      "onGameLose": true,
      "onBackground": true
    }
  },
  "modules": {
    "main": "var PIPE_SPAWN_INTERVAL = 2.5;\nvar FLAP_VELOCITY_Y = 7;\nvar PIPE_SPAWN_X = 8;\nvar PIPE_SPAWN_Y = 0;\nvar pipeSpawnTimer = 0;\n\nexports.onInput = (ctx, event) => {\n\tvar birds, vel;\n\tif (event.type === \"tap\") {\n\t\tbirds = ctx.queryEntities({ tag: \"bird\" });\n\t\tif (birds.length > 0) {\n\t\t\tvel = ctx.getEntityVelocity(birds[0]);\n\t\t\tctx.setEntityVelocity(birds[0], {\n\t\t\t\tx: vel ? vel.x : 0,\n\t\t\t\ty: FLAP_VELOCITY_Y,\n\t\t\t});\n\t\t}\n\t}\n};\n\nexports.onUpdate = (ctx, dt) => {\n\tpipeSpawnTimer += dt;\n\tif (pipeSpawnTimer >= PIPE_SPAWN_INTERVAL) {\n\t\tpipeSpawnTimer -= PIPE_SPAWN_INTERVAL;\n\t\tctx.spawnEntity(\"pipeGroup\", { x: PIPE_SPAWN_X, y: PIPE_SPAWN_Y });\n\t}\n};\n"
  }
}