---
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Amen Games | Scripture. Fellowship. Fun.</title>
		<meta name="description" content="Bible party games for your church, youth group, and family game night." />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
	</head>
	<body class="bg-amen-background text-amen-text font-body antialiased selection:bg-amen-secondary selection:text-white">
		<nav class="fixed w-full z-50 bg-amen-background/90 backdrop-blur-sm border-b border-amen-primary/10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex justify-between items-center h-16">
					<div class="flex-shrink-0 flex items-center gap-2">
						<span class="font-heading font-bold text-2xl text-amen-primary">Amen</span>
					</div>
					<div class="hidden md:flex items-center space-x-8">
						<a href="#games" class="text-amen-text hover:text-amen-primary font-medium transition-colors">Games</a>
						<a href="#how-it-works" class="text-amen-text hover:text-amen-primary font-medium transition-colors">How It Works</a>
						<a href="https://app.amen.games" class="bg-amen-primary text-white px-5 py-2 rounded-full font-medium hover:bg-amen-primary/90 transition-colors shadow-sm hover:shadow-md">
							Play Now
						</a>
					</div>
				</div>
			</div>
		</nav>

		<main>
			{/* Hero Section */}
			<section class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
				<div class="absolute inset-0 -z-10 opacity-10">
					<div class="absolute top-0 left-1/4 w-96 h-96 bg-amen-secondary rounded-full blur-3xl"></div>
					<div class="absolute bottom-0 right-1/4 w-96 h-96 bg-amen-primary rounded-full blur-3xl"></div>
				</div>
				
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
					<h1 class="font-heading text-5xl md:text-7xl font-bold text-amen-primary mb-6 tracking-tight">
						Scripture. <span class="text-amen-secondary">Fellowship.</span> Fun.
					</h1>
					<p class="text-xl md:text-2xl text-amen-textSecondary max-w-2xl mx-auto mb-10 leading-relaxed">
						Bible party games for your church, youth group, and family game night.
					</p>
					<div class="flex flex-col sm:flex-row justify-center gap-4">
						<a href="https://app.amen.games" class="bg-amen-primary text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-amen-primary/90 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
							Start Playing
						</a>
						<a href="#games" class="bg-white text-amen-primary border border-amen-primary/20 px-8 py-4 rounded-full text-lg font-semibold hover:bg-amen-background transition-colors">
							View Games
						</a>
					</div>
				</div>
			</section>

			{/* Games Section */}
			<section id="games" class="py-20 bg-white">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="text-center mb-16">
						<h2 class="font-heading text-4xl font-bold text-amen-primary mb-4">Our Games</h2>
						<p class="text-lg text-amen-textSecondary">Five exciting ways to play and learn together.</p>
					</div>

					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
						{[
							{
								title: "Crowd Comedy",
								desc: "Write the funniest punchline to Bible-themed prompts.",
								icon: "🎭"
							},
							{
								title: "Chroma Clues",
								desc: "Guess the Bible story from abstract color patterns.",
								icon: "🎨"
							},
							{
								title: "Punchline Duel",
								desc: "Head-to-head comedy battles for the quick-witted.",
								icon: "⚔️"
							},
							{
								title: "The Fellowship Table",
								desc: "Hilarious fill-in-the-blank scenarios for groups.",
								icon: "🥖"
							},
							{
								title: "Who Am I?",
								desc: "Classic charades with biblical figures and stories.",
								icon: "🤔"
							}
						].map(game => (
							<div class="bg-amen-background rounded-2xl p-8 border border-amen-primary/5 hover:border-amen-secondary/50 transition-colors group">
								<div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300 inline-block">{game.icon}</div>
								<h3 class="font-heading text-2xl font-bold text-amen-primary mb-2">{game.title}</h3>
								<p class="text-amen-textSecondary leading-relaxed">{game.desc}</p>
							</div>
						))}
					</div>
				</div>
			</section>

			{/* How It Works */}
			<section id="how-it-works" class="py-20 bg-amen-primary text-white relative overflow-hidden">
				<div class="absolute inset-0 opacity-10 bg-[url('/pattern.svg')]"></div>
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
					<div class="text-center mb-16">
						<h2 class="font-heading text-4xl font-bold mb-4 text-white">How It Works</h2>
						<p class="text-lg text-amen-secondary">Get started in seconds. No app download required.</p>
					</div>

					<div class="grid md:grid-cols-3 gap-12 text-center">
						<div class="relative">
							<div class="w-16 h-16 bg-amen-secondary rounded-full flex items-center justify-center text-2xl font-bold text-amen-primary mx-auto mb-6 shadow-lg">1</div>
							<h3 class="font-heading text-xl font-bold mb-3">Host Picks a Game</h3>
							<p class="text-white/80">Launch amen.games on a TV or projector screen.</p>
						</div>
						<div class="relative">
							<div class="w-16 h-16 bg-amen-secondary rounded-full flex items-center justify-center text-2xl font-bold text-amen-primary mx-auto mb-6 shadow-lg">2</div>
							<h3 class="font-heading text-xl font-bold mb-3">Players Join</h3>
							<p class="text-white/80">Everyone joins on their phones using the room code.</p>
						</div>
						<div class="relative">
							<div class="w-16 h-16 bg-amen-secondary rounded-full flex items-center justify-center text-2xl font-bold text-amen-primary mx-auto mb-6 shadow-lg">3</div>
							<h3 class="font-heading text-xl font-bold mb-3">Play Together</h3>
							<p class="text-white/80">Compete, laugh, and learn on the big screen.</p>
						</div>
					</div>
				</div>
			</section>

			{/* Use Cases */}
			<section class="py-20 bg-amen-background">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="grid md:grid-cols-3 gap-8">
						<div class="bg-white p-8 rounded-2xl shadow-sm border border-amen-primary/5">
							<h3 class="font-heading text-2xl font-bold text-amen-primary mb-4">Church Game Nights</h3>
							<p class="text-amen-textSecondary">Perfect for fellowship halls and community events. Engaging for all ages.</p>
						</div>
						<div class="bg-white p-8 rounded-2xl shadow-sm border border-amen-primary/5">
							<h3 class="font-heading text-2xl font-bold text-amen-primary mb-4">Youth Groups</h3>
							<p class="text-amen-textSecondary">High-energy ice breakers that get students laughing and interacting.</p>
						</div>
						<div class="bg-white p-8 rounded-2xl shadow-sm border border-amen-primary/5">
							<h3 class="font-heading text-2xl font-bold text-amen-primary mb-4">Family Devotionals</h3>
							<p class="text-amen-textSecondary">Make family Bible time fun and interactive. Great for holidays too.</p>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="bg-amen-primary text-white py-12 border-t border-white/10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
				<div class="flex flex-col md:flex-row justify-between items-center gap-6">
					<div class="text-center md:text-left">
						<span class="font-heading font-bold text-2xl block mb-2">Amen</span>
						<p class="text-sm text-white/60">© 2026 Amen Games. All rights reserved.</p>
					</div>
					<div class="flex gap-8 text-sm text-white/80">
						<a href="https://amen.games/privacy" class="hover:text-amen-secondary transition-colors">Privacy Policy</a>
						<a href="https://amen.games/terms" class="hover:text-amen-secondary transition-colors">Terms of Service</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
</html>
