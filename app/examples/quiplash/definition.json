{
	"metadata": {
		"id": "quiplash",
		"slug": "quiplash",
		"title": "Quiplash",
		"description": "Fill-in-the-blank comedy game. Players submit funny answers, then vote head-to-head!",
		"instructions": "Answer prompts with your funniest response. Vote for your favorite in each matchup. Get the most votes to win!",
		"version": "1.0.0"
	},
	"world": {
		"gravity": { "x": 0, "y": 0 },
		"pixelsPerMeter": 50,
		"bounds": { "width": 12, "height": 16 }
	},
	"camera": { "type": "fixed", "zoom": 1 },
	"background": { "type": "static", "color": "#1a0a2e" },
	"variables": {
		"phase": "lobby",
		"roundNumber": 0,
		"promptText": "",
		"answerA": "",
		"answerB": "",
		"scoreboardJson": "[]",
		"winnerName": "",
		"timerRemaining": 0,
		"matchupIndex": 0,
		"totalMatchups": 0,
		"voteResultA": 0,
		"voteResultB": 0,
		"assignmentsJson": "{}",
		"votersJson": "[]",
		"roundMultiplier": 1,
		"pointsA": 0,
		"pointsB": 0,
		"quiplashA": false,
		"quiplashB": false
	},
	"prefabs": {},
	"entities": [],
	"party": {
		"maxPlayers": 8,
		"minPlayers": 3
	},
	"overlay": {
		"theme": {
			"primaryColor": "#7B2FBE",
			"textColor": "#FFFFFF",
			"backgroundColor": "#1a0a2e"
		},
		"elements": [
			{
				"id": "host-room-code",
				"type": "text",
				"anchor": "top-right",
				"offset": { "x": 16, "y": 16 },
				"fontSize": 14,
				"color": "#AAAAAA",
				"visibleWhen": "role == 'host' && room.phase == 'lobby'",
				"bindings": { "text": "Room Code: {{variables.roomCode}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.6)",
					"borderRadius": 8,
					"paddingHorizontal": 12,
					"paddingVertical": 6
				}
			},
			{
				"id": "host-player-count",
				"type": "text",
				"anchor": "top-left",
				"offset": { "x": 16, "y": 16 },
				"fontSize": 14,
				"color": "#AAAAAA",
				"visibleWhen": "role == 'host' && room.phase == 'lobby'",
				"bindings": { "text": "Players: {{room.playerCount}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.6)",
					"borderRadius": 8,
					"paddingHorizontal": 12,
					"paddingVertical": 6
				}
			},
			{
				"id": "host-lobby-title",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -80 },
				"fontSize": 36,
				"fontWeight": "bold",
				"color": "#FFD700",
				"text": "QUIPLASH",
				"visibleWhen": "role == 'host' && room.phase == 'lobby'"
			},
			{
				"id": "host-lobby-subtitle",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -30 },
				"fontSize": 16,
				"color": "#AAAAAA",
				"visibleWhen": "role == 'host' && room.phase == 'lobby'",
				"bindings": {
					"text": "Waiting for players... ({{room.playerCount}} joined)"
				}
			},
			{
				"id": "host-start-button",
				"type": "button",
				"anchor": "center",
				"offset": { "x": 0, "y": 30 },
				"label": "Start Game",
				"eventName": "start_game",
				"color": "#7B2FBE",
				"textColor": "#FFFFFF",
				"fontSize": 18,
				"visibleWhen": "role == 'host' && room.phase == 'lobby'",
				"style": {
					"borderRadius": 12,
					"paddingHorizontal": 24,
					"paddingVertical": 12
				}
			},
			{
				"id": "host-round-banner",
				"type": "text",
				"anchor": "top-center",
				"offset": { "x": 0, "y": 16 },
				"fontSize": 20,
				"fontWeight": "bold",
				"color": "#FFD700",
				"visibleWhen": "role == 'host' && room.phase != 'lobby' && room.phase != 'winner'",
				"bindings": { "text": "ROUND {{room.roundNumber}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.6)",
					"borderRadius": 8,
					"paddingHorizontal": 16,
					"paddingVertical": 8
				}
			},
			{
				"id": "host-round-multiplier",
				"type": "text",
				"anchor": "top-center",
				"offset": { "x": 0, "y": 60 },
				"fontSize": 14,
				"color": "#AAAAAA",
				"visibleWhen": "role == 'host' && room.phase != 'lobby' && room.phase != 'winner'",
				"bindings": { "text": "{{room.roundMultiplier}}x Points" }
			},
			{
				"id": "host-prompt-text",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -60 },
				"fontSize": 22,
				"fontWeight": "bold",
				"color": "#FFFFFF",
				"align": "center",
				"maxWidth": 300,
				"visibleWhen": "role == 'host' && (room.phase == 'voting' || room.phase == 'reveal')",
				"bindings": { "text": "{{room.promptText}}" },
				"style": {
					"backgroundColor": "rgba(123,47,190,0.3)",
					"borderRadius": 12,
					"paddingHorizontal": 20,
					"paddingVertical": 16
				}
			},
			{
				"id": "host-answer-a",
				"type": "text",
				"anchor": "center",
				"offset": { "x": -80, "y": 20 },
				"fontSize": 18,
				"color": "#FFFFFF",
				"align": "center",
				"maxWidth": 140,
				"visibleWhen": "role == 'host' && (room.phase == 'voting' || room.phase == 'reveal')",
				"bindings": { "text": "{{room.answerA}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.5)",
					"borderRadius": 10,
					"paddingHorizontal": 16,
					"paddingVertical": 12
				}
			},
			{
				"id": "host-answer-b",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 80, "y": 20 },
				"fontSize": 18,
				"color": "#FFFFFF",
				"align": "center",
				"maxWidth": 140,
				"visibleWhen": "role == 'host' && (room.phase == 'voting' || room.phase == 'reveal')",
				"bindings": { "text": "{{room.answerB}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.5)",
					"borderRadius": 10,
					"paddingHorizontal": 16,
					"paddingVertical": 12
				}
			},
			{
				"id": "host-vote-result-a",
				"type": "text",
				"anchor": "center",
				"offset": { "x": -80, "y": 70 },
				"fontSize": 24,
				"fontWeight": "bold",
				"color": "#4CAF50",
				"visibleWhen": "role == 'host' && room.phase == 'reveal'",
				"bindings": { "text": "{{room.voteResultA}}%" }
			},
			{
				"id": "host-vote-result-b",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 80, "y": 70 },
				"fontSize": 24,
				"fontWeight": "bold",
				"color": "#2196F3",
				"visibleWhen": "role == 'host' && room.phase == 'reveal'",
				"bindings": { "text": "{{room.voteResultB}}%" }
			},
			{
				"id": "host-points-a",
				"type": "text",
				"anchor": "center",
				"offset": { "x": -80, "y": 100 },
				"fontSize": 16,
				"color": "#FFD700",
				"visibleWhen": "role == 'host' && room.phase == 'reveal'",
				"bindings": { "text": "+{{room.pointsA}}" }
			},
			{
				"id": "host-points-b",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 80, "y": 100 },
				"fontSize": 16,
				"color": "#FFD700",
				"visibleWhen": "role == 'host' && room.phase == 'reveal'",
				"bindings": { "text": "+{{room.pointsB}}" }
			},
			{
				"id": "host-quiplash-a",
				"type": "text",
				"anchor": "center",
				"offset": { "x": -80, "y": 130 },
				"fontSize": 14,
				"fontWeight": "bold",
				"color": "#FF4081",
				"text": "QUIPLASH!",
				"visibleWhen": "role == 'host' && room.phase == 'reveal' && room.quiplashA == true"
			},
			{
				"id": "host-quiplash-b",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 80, "y": 130 },
				"fontSize": 14,
				"fontWeight": "bold",
				"color": "#FF4081",
				"text": "QUIPLASH!",
				"visibleWhen": "role == 'host' && room.phase == 'reveal' && room.quiplashB == true"
			},
			{
				"id": "host-answering-waiting",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -20 },
				"fontSize": 18,
				"color": "#AAAAAA",
				"text": "Players are writing answers...",
				"visibleWhen": "role == 'host' && room.phase == 'answering'"
			},
			{
				"id": "host-voting-waiting",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 160 },
				"fontSize": 14,
				"color": "#AAAAAA",
				"text": "Vote now!",
				"visibleWhen": "role == 'host' && room.phase == 'voting'"
			},
			{
				"id": "host-timer",
				"type": "text",
				"anchor": "bottom-center",
				"offset": { "x": 0, "y": 40 },
				"fontSize": 28,
				"fontWeight": "bold",
				"color": "#FFFFFF",
				"visibleWhen": "role == 'host' && (room.phase == 'answering' || room.phase == 'voting')",
				"bindings": { "text": "{{room.timerRemaining}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.6)",
					"borderRadius": 24,
					"paddingHorizontal": 20,
					"paddingVertical": 10
				}
			},
			{
				"id": "host-timer-bar",
				"type": "bar",
				"anchor": "bottom-center",
				"offset": { "x": 0, "y": 80 },
				"width": 280,
				"height": 8,
				"color": "#7B2FBE",
				"backgroundColor": "rgba(255,255,255,0.1)",
				"borderRadius": 4,
				"visibleWhen": "role == 'host' && (room.phase == 'answering' || room.phase == 'voting')",
				"bindings": { "value": "room.timerRemaining", "max": "30" }
			},
			{
				"id": "host-scoreboard-title",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -100 },
				"fontSize": 28,
				"fontWeight": "bold",
				"color": "#FFD700",
				"text": "SCOREBOARD",
				"visibleWhen": "role == 'host' && room.phase == 'scores'"
			},
			{
				"id": "host-scoreboard-data",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 0 },
				"fontSize": 16,
				"color": "#FFFFFF",
				"align": "center",
				"maxWidth": 300,
				"visibleWhen": "role == 'host' && room.phase == 'scores'",
				"bindings": { "text": "{{room.scoreboardJson}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.5)",
					"borderRadius": 12,
					"paddingHorizontal": 20,
					"paddingVertical": 16
				}
			},
			{
				"id": "host-winner-title",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -40 },
				"fontSize": 32,
				"fontWeight": "bold",
				"color": "#FFD700",
				"text": "WINNER",
				"visibleWhen": "role == 'host' && room.phase == 'winner'"
			},
			{
				"id": "host-winner-name",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 20 },
				"fontSize": 28,
				"fontWeight": "bold",
				"color": "#FFFFFF",
				"visibleWhen": "role == 'host' && room.phase == 'winner'",
				"bindings": { "text": "{{room.winnerName}}" },
				"style": {
					"backgroundColor": "rgba(123,47,190,0.4)",
					"borderRadius": 12,
					"paddingHorizontal": 24,
					"paddingVertical": 12
				}
			},
			{
				"id": "player-lobby-status",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 0 },
				"fontSize": 18,
				"color": "#AAAAAA",
				"text": "Joined! Waiting for host to start...",
				"visibleWhen": "role == 'player' && room.phase == 'lobby'"
			},
			{
				"id": "player-answer-hint",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 0 },
				"fontSize": 18,
				"color": "#AAAAAA",
				"text": "Type your answers on your phone",
				"visibleWhen": "role == 'player' && room.phase == 'answering'"
			},
			{
				"id": "player-vote-hint",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 0 },
				"fontSize": 18,
				"color": "#AAAAAA",
				"text": "Vote on your phone!",
				"visibleWhen": "role == 'player' && room.phase == 'voting'"
			},
			{
				"id": "player-score",
				"type": "text",
				"anchor": "top-center",
				"offset": { "x": 0, "y": 16 },
				"fontSize": 16,
				"fontWeight": "bold",
				"color": "#FFFFFF",
				"visibleWhen": "role == 'player' && room.phase != 'lobby'",
				"bindings": { "text": "Score: {{room.player0_score}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.6)",
					"borderRadius": 8,
					"paddingHorizontal": 12,
					"paddingVertical": 6
				}
			},
			{
				"id": "player-game-over",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 0 },
				"fontSize": 22,
				"fontWeight": "bold",
				"color": "#FFD700",
				"text": "Game Over!",
				"visibleWhen": "role == 'player' && room.phase == 'winner'"
			}
		]
	},
	"script": "exports.onNetworkState = function(ctx, state) {\n  var keys = ['phase', 'roundNumber', 'promptText', 'answerA', 'answerB',\n              'scoreboardJson', 'winnerName', 'timerRemaining',\n              'matchupIndex', 'totalMatchups', 'voteResultA', 'voteResultB',\n              'assignmentsJson', 'votersJson', 'roundMultiplier',\n              'pointsA', 'pointsB', 'quiplashA', 'quiplashB'];\n  for (var i = 0; i < keys.length; i++) {\n    if (state[keys[i]] !== undefined) ctx.setVariable(keys[i], state[keys[i]]);\n  }\n};\n"
}
