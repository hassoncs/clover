{
	"metadata": {
		"id": "party-question-answer",
		"slug": "partyQuestionAnswer",
		"title": "Question & Answer",
		"description": "A party game where players answer fun questions",
		"instructions": "Host starts the game, players type answers to each question",
		"version": "1.0.0"
	},
	"world": {
		"gravity": { "x": 0, "y": 0 },
		"pixelsPerMeter": 50,
		"bounds": { "width": 12, "height": 16 }
	},
	"camera": { "type": "fixed", "zoom": 1 },
	"background": { "type": "static", "color": "#1a1a2e" },
	"variables": {
		"qaPhase": "lobby",
		"prompt": "",
		"questionIndex": 0,
		"totalQuestions": 5,
		"timerRemaining": 0,
		"answersJson": "[]"
	},
	"prefabs": {},
	"entities": [],
	"party": {
		"maxPlayers": 8
	},
	"overlay": {
		"theme": {
			"primaryColor": "#6C63FF",
			"textColor": "#FFFFFF",
			"backgroundColor": "#1a1a2e"
		},
		"elements": [
			{
				"id": "room-code",
				"type": "text",
				"anchor": "top-right",
				"offset": { "x": 16, "y": 16 },
				"fontSize": 14,
				"color": "#AAAAAA",
				"visibleWhen": "role == 'host'",
				"bindings": { "text": "ROOM: {{variables.roomCode}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.6)",
					"borderRadius": 8,
					"paddingHorizontal": 12,
					"paddingVertical": 6
				}
			},
			{
				"id": "player-count",
				"type": "text",
				"anchor": "top-left",
				"offset": { "x": 16, "y": 16 },
				"fontSize": 14,
				"color": "#AAAAAA",
				"bindings": { "text": "Players: {{room.playerCount}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.6)",
					"borderRadius": 8,
					"paddingHorizontal": 12,
					"paddingVertical": 6
				}
			},
			{
				"id": "question-counter",
				"type": "text",
				"anchor": "top-center",
				"offset": { "x": 0, "y": 16 },
				"fontSize": 14,
				"color": "#AAAAAA",
				"visibleWhen": "room.qaPhase == 'question' || room.qaPhase == 'reveal'",
				"bindings": {
					"text": "Q{{room.questionIndex + 1}} / {{room.totalQuestions}}"
				},
				"style": {
					"backgroundColor": "rgba(0,0,0,0.6)",
					"borderRadius": 8,
					"paddingHorizontal": 12,
					"paddingVertical": 6
				}
			},
			{
				"id": "lobby-title",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -80 },
				"fontSize": 28,
				"fontWeight": "bold",
				"color": "#FFFFFF",
				"text": "Question & Answer",
				"visibleWhen": "room.qaPhase == 'lobby'"
			},
			{
				"id": "lobby-waiting",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -30 },
				"fontSize": 16,
				"color": "#AAAAAA",
				"visibleWhen": "room.qaPhase == 'lobby'",
				"bindings": {
					"text": "Waiting for players... ({{room.playerCount}} joined)"
				}
			},
			{
				"id": "start-button",
				"type": "button",
				"anchor": "center",
				"offset": { "x": 0, "y": 30 },
				"label": "Start Game",
				"eventName": "start_game",
				"color": "#6C63FF",
				"textColor": "#FFFFFF",
				"fontSize": 18,
				"visibleWhen": "role == 'host' && room.qaPhase == 'lobby'",
				"style": {
					"borderRadius": 12,
					"paddingHorizontal": 24,
					"paddingVertical": 12
				}
			},
			{
				"id": "question-text",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -40 },
				"fontSize": 22,
				"fontWeight": "bold",
				"color": "#FFFFFF",
				"align": "center",
				"maxWidth": 300,
				"visibleWhen": "room.qaPhase == 'question' || room.qaPhase == 'reveal'",
				"bindings": { "text": "{{room.prompt}}" },
				"style": {
					"backgroundColor": "rgba(108,99,255,0.2)",
					"borderRadius": 12,
					"paddingHorizontal": 20,
					"paddingVertical": 16
				}
			},
			{
				"id": "timer-bar",
				"type": "bar",
				"anchor": "center",
				"offset": { "x": 0, "y": 20 },
				"width": 280,
				"height": 12,
				"color": "#6C63FF",
				"backgroundColor": "rgba(255,255,255,0.1)",
				"borderRadius": 6,
				"visibleWhen": "room.qaPhase == 'question'",
				"bindings": { "value": "room.timerRemaining", "max": "30" }
			},
			{
				"id": "waiting-answers",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 50 },
				"fontSize": 14,
				"color": "#AAAAAA",
				"text": "Waiting for answers...",
				"visibleWhen": "role == 'host' && room.qaPhase == 'question'"
			},
			{
				"id": "answers-title",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 40 },
				"fontSize": 18,
				"fontWeight": "bold",
				"color": "#FFD700",
				"text": "Answers",
				"visibleWhen": "room.qaPhase == 'reveal'"
			},
			{
				"id": "answers-list",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 80 },
				"fontSize": 16,
				"color": "#FFFFFF",
				"align": "center",
				"maxWidth": 300,
				"visibleWhen": "room.qaPhase == 'reveal'",
				"bindings": { "text": "{{room.answersJson}}" },
				"style": {
					"backgroundColor": "rgba(0,0,0,0.4)",
					"borderRadius": 8,
					"paddingHorizontal": 16,
					"paddingVertical": 12
				}
			},
			{
				"id": "done-title",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -20 },
				"fontSize": 28,
				"fontWeight": "bold",
				"color": "#FFD700",
				"text": "Game Over!",
				"visibleWhen": "room.qaPhase == 'done'"
			},
			{
				"id": "done-message",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 30 },
				"fontSize": 16,
				"color": "#AAAAAA",
				"text": "Thanks for playing!",
				"visibleWhen": "room.qaPhase == 'done'"
			}
		]
	},
	"script": "exports.onNetworkState = function(ctx, state) {\n  if (state.qaPhase) ctx.setVariable('qaPhase', state.qaPhase);\n  if (state.prompt !== undefined) ctx.setVariable('prompt', state.prompt);\n  if (state.questionIndex !== undefined) ctx.setVariable('questionIndex', state.questionIndex);\n  if (state.totalQuestions !== undefined) ctx.setVariable('totalQuestions', state.totalQuestions);\n  if (state.timerRemaining !== undefined) ctx.setVariable('timerRemaining', state.timerRemaining);\n  if (state.answersJson !== undefined) ctx.setVariable('answersJson', state.answersJson);\n};\n\nexports.onPhaseChange = function(ctx, phase, data) {\n  ctx.setVariable('qaPhase', phase === 'playing' ? 'question' : phase);\n};\n"
}
