{
	"metadata": {
		"id": "quick-poll",
		"slug": "quickPoll",
		"title": "Quick Poll",
		"description": "A simple polling game",
		"instructions": "Host starts a poll, players vote",
		"version": "1.0.0"
	},
	"world": {
		"gravity": { "x": 0, "y": 0 },
		"pixelsPerMeter": 50,
		"bounds": { "width": 12, "height": 16 }
	},
	"camera": { "type": "fixed", "zoom": 1 },
	"background": { "type": "static", "color": "#2c3e50" },
	"variables": {
		"phase": "lobby",
		"pollPrompt": "What is the best fruit?",
		"votesJson": "[]",
		"voteCount": 0
	},
	"prefabs": {},
	"entities": [],
	"party": {
		"maxPlayers": 10
	},
	"overlay": {
		"theme": {
			"primaryColor": "#e74c3c",
			"textColor": "#ecf0f1",
			"backgroundColor": "#2c3e50"
		},
		"elements": [
			{
				"id": "room-code",
				"type": "text",
				"anchor": "top-right",
				"offset": { "x": 16, "y": 16 },
				"fontSize": 14,
				"color": "#bdc3c7",
				"bindings": { "text": "Code: {{variables.roomCode}}" }
			},
			{
				"id": "lobby-msg",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": -50 },
				"text": "Waiting for host...",
				"visibleWhen": "room.phase == 'lobby' && role == 'player'"
			},
			{
				"id": "start-btn",
				"type": "button",
				"anchor": "center",
				"offset": { "x": 0, "y": 0 },
				"label": "Start Poll",
				"eventName": "start_poll",
				"visibleWhen": "room.phase == 'lobby' && role == 'host'"
			},
			{
				"id": "poll-prompt",
				"type": "text",
				"anchor": "top-center",
				"offset": { "x": 0, "y": 100 },
				"fontSize": 24,
				"bindings": { "text": "{{room.pollPrompt}}" },
				"visibleWhen": "room.phase == 'voting'"
			},
			{
				"id": "vote-input",
				"type": "text-input",
				"anchor": "center",
				"offset": { "x": 0, "y": 0 },
				"placeholder": "Type your vote...",
				"eventName": "submit_vote",
				"visibleWhen": "room.phase == 'voting' && role == 'player'"
			},
			{
				"id": "host-waiting",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 50 },
				"bindings": { "text": "Votes received: {{room.voteCount}}" },
				"visibleWhen": "room.phase == 'voting' && role == 'host'"
			},
			{
				"id": "reveal-btn",
				"type": "button",
				"anchor": "bottom-center",
				"offset": { "x": 0, "y": -50 },
				"label": "Reveal Votes",
				"eventName": "reveal_votes",
				"visibleWhen": "room.phase == 'voting' && role == 'host'"
			},
			{
				"id": "results-list",
				"type": "text",
				"anchor": "center",
				"offset": { "x": 0, "y": 0 },
				"bindings": { "text": "Results: {{room.votesJson}}" },
				"visibleWhen": "room.phase == 'results'"
			}
		]
	},
	"script": "exports.onNetworkState = function(ctx, state) {\n  if (state.phase) ctx.setVariable('phase', state.phase);\n  if (state.pollPrompt) ctx.setVariable('pollPrompt', state.pollPrompt);\n  if (state.votesJson) ctx.setVariable('votesJson', state.votesJson);\n  if (state.voteCount !== undefined) ctx.setVariable('voteCount', state.voteCount);\n};\n"
}
