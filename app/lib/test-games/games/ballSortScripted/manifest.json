{
  "name": "test-ball-sort-scripted",
  "version": "1.0.0",
  "title": "Ball Sort (Scripted)",
  "description": "Sort colored balls into tubes - using the generic scripting system",
  "instructions": "Tap a tube to pick up the top ball, then tap another tube to drop it. You can only drop on the same color or an empty tube.",
  "world": {
    "gravity": {
      "x": 0,
      "y": 0
    },
    "pixelsPerMeter": 50,
    "bounds": {
      "width": 14.4,
      "height": 25.6
    }
  },
  "background": {
    "type": "static"
  },
  "camera": {
    "type": "fixed",
    "zoom": 1
  },
  "ui": {
    "showTimer": true,
    "timerCountdown": false,
    "backgroundColor": "#1a237e",
    "variableDisplays": [
      {
        "name": "moveCount",
        "label": "Moves",
        "color": "#4CAF50"
      },
      {
        "name": "currentLevel",
        "label": "Level",
        "color": "#FFD700"
      }
    ]
  },
  "input": {
    "debugInputs": true
  },
  "variables": {
    "currentLevel": 1,
    "heldBallColor": -1,
    "sourceTubeIndex": -1,
    "heldBallId": "",
    "moveCount": 0,
    "startTime": 0,
    "_winAtElapsed": 0,
    "_invalidFeedbackStart": 0,
    "tube0_count": 2,
    "tube1_count": 2,
    "tube2_count": 4,
    "tube3_count": 0,
    "tube4_count": 0,
    "tube5_count": 0,
    "tube0_topColor": 0,
    "tube1_topColor": 1,
    "tube2_topColor": 1,
    "tube3_topColor": -1,
    "tube4_topColor": -1,
    "tube5_topColor": -1
  },
  "containers": [
    {
      "id": "tube-0",
      "type": "stack",
      "capacity": 4,
      "layout": {
        "direction": "vertical",
        "spacing": 1.32,
        "basePosition": {
          "x": -5.485714285714286,
          "y": -3.1999999999999993
        },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-1",
      "type": "stack",
      "capacity": 4,
      "layout": {
        "direction": "vertical",
        "spacing": 1.32,
        "basePosition": {
          "x": -3.291428571428572,
          "y": -3.1999999999999993
        },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-2",
      "type": "stack",
      "capacity": 4,
      "layout": {
        "direction": "vertical",
        "spacing": 1.32,
        "basePosition": {
          "x": -1.0971428571428579,
          "y": -3.1999999999999993
        },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-3",
      "type": "stack",
      "capacity": 4,
      "layout": {
        "direction": "vertical",
        "spacing": 1.32,
        "basePosition": {
          "x": 1.097142857142856,
          "y": -3.1999999999999993
        },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-4",
      "type": "stack",
      "capacity": 4,
      "layout": {
        "direction": "vertical",
        "spacing": 1.32,
        "basePosition": {
          "x": 3.29142857142857,
          "y": -3.1999999999999993
        },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-5",
      "type": "stack",
      "capacity": 4,
      "layout": {
        "direction": "vertical",
        "spacing": 1.32,
        "basePosition": {
          "x": 5.485714285714284,
          "y": -3.1999999999999993
        },
        "anchor": "bottom"
      }
    }
  ],
  "stateMachines": [
    {
      "id": "gameFlow",
      "initialState": "idle",
      "states": [
        { "id": "idle" },
        { "id": "holding" }
      ],
      "transitions": [
        {
          "id": "pickup",
          "from": "idle",
          "to": "holding",
          "trigger": {
            "type": "event",
            "eventName": "ball_picked"
          }
        },
        {
          "id": "drop",
          "from": "holding",
          "to": "idle",
          "trigger": {
            "type": "event",
            "eventName": "ball_dropped"
          }
        },
        {
          "id": "cancel",
          "from": "holding",
          "to": "idle",
          "trigger": {
            "type": "event",
            "eventName": "pickup_cancelled"
          }
        }
      ]
    }
  ],
  "hoverHighlight": {
    "targetTag": "tube",
    "highlightEntityId": "tube-hover-highlight"
  },
  "winCondition": {}
}