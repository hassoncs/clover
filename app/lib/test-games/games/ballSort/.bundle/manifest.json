{
  "name": "ball-sort",
  "version": "1.1.0",
  "title": "Ball Sort",
  "description": "Sort colored balls into tubes - each tube should contain only one color",
  "instructions": "Tap a tube to pick up the top ball, then tap another tube to drop it. You can only drop on the same color or an empty tube.",
  "titleHeroImageUrl": "https://slopcade-api.hassoncs.workers.dev/assets/generated/ballSort/title_hero.png",
  "world": {
    "gravity": { "x": 0, "y": 0 },
    "pixelsPerMeter": { "const": "PIXELS_PER_METER" },
    "bounds": { "width": { "const": "WORLD_WIDTH" }, "height": { "const": "WORLD_HEIGHT" } }
  },
  "background": {
    "type": "static",
    "imageUrl": "https://slopcade-api.hassoncs.workers.dev/assets/generated/ballSort/background.png"
  },
  "camera": {
    "type": "fixed",
    "zoom": 1
  },
  "input": {
    "debugInputs": true
  },
  "variables": {
    "currentLevel": 1,
    "heldBallColor": -1,
    "sourceTubeIndex": -1,
    "heldBallId": "",
    "moveCount": 0,
    "startTime": 0,
    "tube0_count": 4,
    "tube1_count": 4,
    "tube2_count": 4,
    "tube3_count": 4,
    "tube4_count": 0,
    "tube5_count": 0,
    "tube0_topColor": 3,
    "tube1_topColor": 0,
    "tube2_topColor": 1,
    "tube3_topColor": 2,
    "tube4_topColor": -1,
    "tube5_topColor": -1
  },
  "containers": [
    {
      "id": "tube-0",
      "type": "stack",
      "capacity": { "const": "BALLS_PER_TUBE" },
      "layout": {
        "direction": "vertical",
        "spacing": { "const": "BALL_SPACING" },
        "basePosition": { "x": -4.2, "y": -3.2 },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-1",
      "type": "stack",
      "capacity": { "const": "BALLS_PER_TUBE" },
      "layout": {
        "direction": "vertical",
        "spacing": { "const": "BALL_SPACING" },
        "basePosition": { "x": -2.04, "y": -3.2 },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-2",
      "type": "stack",
      "capacity": { "const": "BALLS_PER_TUBE" },
      "layout": {
        "direction": "vertical",
        "spacing": { "const": "BALL_SPACING" },
        "basePosition": { "x": 0.12, "y": -3.2 },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-3",
      "type": "stack",
      "capacity": { "const": "BALLS_PER_TUBE" },
      "layout": {
        "direction": "vertical",
        "spacing": { "const": "BALL_SPACING" },
        "basePosition": { "x": 2.28, "y": -3.2 },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-4",
      "type": "stack",
      "capacity": { "const": "BALLS_PER_TUBE" },
      "layout": {
        "direction": "vertical",
        "spacing": { "const": "BALL_SPACING" },
        "basePosition": { "x": 4.44, "y": -3.2 },
        "anchor": "bottom"
      }
    },
    {
      "id": "tube-5",
      "type": "stack",
      "capacity": { "const": "BALLS_PER_TUBE" },
      "layout": {
        "direction": "vertical",
        "spacing": { "const": "BALL_SPACING" },
        "basePosition": { "x": 6.6, "y": -3.2 },
        "anchor": "bottom"
      }
    }
  ],
  "ui": {
    "showScore": false,
    "showLives": false,
    "showTimer": true,
    "timerCountdown": false,
    "backgroundColor": "#1a237e",
    "variableDisplays": [
      {
        "name": "moveCount",
        "label": "Moves",
        "color": "#4CAF50"
      },
      {
        "name": "currentLevel",
        "label": "Level",
        "color": "#FFD700"
      }
    ]
  },
  "stateMachines": [
    {
      "id": "gameFlow",
      "initialState": "idle",
      "states": [
        { "id": "idle" },
        { "id": "holding" }
      ],
      "transitions": [
        {
          "id": "pickup",
          "from": "idle",
          "to": "holding",
          "trigger": { "type": "event", "eventName": "ball_picked" }
        },
        {
          "id": "drop",
          "from": "holding",
          "to": "idle",
          "trigger": { "type": "event", "eventName": "ball_dropped" }
        },
        {
          "id": "cancel",
          "from": "holding",
          "to": "idle",
          "trigger": { "type": "event", "eventName": "pickup_cancelled" }
        }
      ]
    }
  ],
  "winCondition": {
    "type": "custom"
  },
  "generators": {
    "puzzle": {
      "script": "generators/puzzleGenerator.js",
      "export": "generate",
      "runOn": "load"
    }
  },
  "scripts": {
    "runtime": {
      "sandbox": "quickjs",
      "permissions": ["read:variables", "write:variables", "read:entities", "write:entities"]
    }
  }
}
