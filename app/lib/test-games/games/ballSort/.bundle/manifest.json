{
  "name": "test-ball-sort",
  "version": "1.1.0",
  "title": "Ball Sort",
  "description": "Sort colored balls into tubes - each tube should contain only one color",
  "instructions": "Tap a tube to pick up the top ball, then tap another tube to drop it. You can only drop on the same color or an empty tube.",
  "world": {
    "gravity": {
      "x": 0,
      "y": 0
    },
    "pixelsPerMeter": 50,
    "bounds": {
      "width": 14.4,
      "height": 25.6
    }
  },
  "background": {
    "type": "static"
  },
  "camera": {
    "type": "fixed",
    "zoom": 1
  },
  "ui": {
    "showTimer": true,
    "timerCountdown": false,
    "backgroundColor": "#1a237e",
    "variableDisplays": [
      {
        "name": "moveCount",
        "label": "Moves",
        "color": "#4CAF50"
      },
      {
        "name": "currentLevel",
        "label": "Level",
        "color": "#FFD700"
      }
    ]
  }
}