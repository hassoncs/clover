{
  "name": "test-flappy-bird",
  "version": "1.1.0",
  "title": "Flappy Bird",
  "description": "Tap to fly through the pipes without hitting them",
  "instructions": "Tap anywhere to flap! Avoid the pipes and ground.",
  "world": {
    "gravity": {
      "x": 0,
      "y": -15
    },
    "pixelsPerMeter": 50,
    "bounds": {
      "width": 12,
      "height": 16
    }
  },
  "background": {
    "type": "static"
  },
  "camera": {
    "type": "fixed",
    "zoom": 1
  },
  "ui": {
    "showTimer": false,
    "backgroundColor": "#70c5ce",
    "variableDisplays": [
      {
        "name": "score",
        "label": "Score"
      }
    ]
  },
  "loseCondition": {
    "type": "entity_destroyed",
    "tag": "bird"
  }
}