{
  "name": "pinball-lite",
  "version": "1.0.0",
  "title": "Pinball Lite",
  "description": "Pinball table with bumpers, flippers - reach 5000 points to win!",
  "instructions": "Tap left/right side to flip. Hit bumpers and targets to score 5000 points!",
  "titleHeroImageUrl": { "const": "ASSET_BASE" },
  "world": {
    "gravity": { "x": 0, "y": -8 },
    "pixelsPerMeter": 50,
    "bounds": { "width": { "const": "WORLD_WIDTH" }, "height": { "const": "WORLD_HEIGHT" } }
  },
  "camera": { "type": "fixed", "zoom": 1 },
  "ui": {
    "showScore": true,
    "showLives": true,
    "showTimer": false,
    "backgroundColor": "#0a0a2e"
  },
  "winCondition": {
    "type": "score",
    "score": 5000
  },
  "loseCondition": {
    "type": "lives_zero"
  },
  "initialLives": 3
}
