{
  "name": "angry-burns",
  "version": "1.0.0",
  "title": "Angry Burns",
  "description": "Pull back the cannon to launch cannonballs at structures and destroy all the targets to win!",
  "instructions": "Pull back the cannon to aim, release to fire! Destroy all targets.",
  "world": {
    "gravity": { "x": 0, "y": 9.8 },
    "pixelsPerMeter": 50,
    "bounds": { "width": { "const": "WORLD_WIDTH" }, "height": { "const": "WORLD_HEIGHT" } }
  },
  "camera": { "type": "fixed", "zoom": 1 },
  "ui": {
    "showScore": true,
    "showLives": true,
    "showTimer": false,
    "backgroundColor": "#87CEEB"
  },
  "winCondition": {
    "type": "destroy_all",
    "tag": "target"
  },
  "loseCondition": {
    "type": "lives_zero"
  },
  "initialLives": 5,
  "initialScore": 0
}
