          { "type": "scale_oscillate", "min": 0.97, "max": 1.06, "speed": 5 },
          { "type": "sprite_effect", "effect": "glow", "params": { "pulse": true } }
        ]
      },
      {
        "when": { "hasTag": "sys.match3:matched" },
        "priority": 3,
        "behaviors": [{ "type": "sprite_effect", "effect": "fade_out", "params": { "duration": 0.4 } }]
      }
    ]
  },
