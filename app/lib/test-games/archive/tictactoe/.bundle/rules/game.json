[
  {
    "id": "tap_cell",
    "name": "Tap any cell",
    "trigger": { "type": "tap", "target": "cell" },
    "conditions": [
      { "type": "expression", "expr": "!stateIs('turnFlow', 'gameOver')" }
    ],
    "actions": [
      { "type": "run_script", "script": "scripts/game.js", "export": "handleCellTap" }
    ]
  },
  {
    "id": "check_win_after_move",
    "name": "Check for win after move",
    "trigger": { "type": "event", "eventName": "move_committed" },
    "actions": [
      { "type": "run_script", "script": "scripts/game.js", "export": "checkWin" }
    ]
  },
  {
    "id": "tap_to_reset",
    "name": "Tap to reset after game over",
    "trigger": { "type": "tap" },
    "conditions": [
      { "type": "expression", "expr": "stateIs('turnFlow', 'gameOver')" }
    ],
    "actions": [
      { "type": "run_script", "script": "scripts/game.js", "export": "resetGame" }
    ]
  }
]
