{
  "name": "bubble-shooter",
  "version": "1.0.0",
  "title": "Bubble Shooter",
  "description": "Match 3+ bubbles of the same color to pop them and clear the board",
  "instructions": "Drag to aim, release to shoot. Match 3+ same-colored bubbles to pop them!",
  "titleHeroImageUrl": { "const": "ASSET_BASE" },
  "world": {
    "gravity": { "x": 0, "y": 0 },
    "pixelsPerMeter": 50,
    "bounds": { "width": { "const": "WORLD_WIDTH" }, "height": { "const": "WORLD_HEIGHT" } }
  },
  "background": {
    "type": "static",
    "imageUrl": { "const": "ASSET_BASE" }
  },
  "camera": { "type": "fixed", "zoom": 1 },
  "ui": {
    "showScore": true,
    "showLives": false,
    "showTimer": false,
    "backgroundColor": "#1a1a2e"
  },
  "winCondition": {
    "type": "destroy_all",
    "tag": "bubble"
  },
  "loseCondition": {
    "type": "custom"
  },
  "generators": {
    "bubbles": {
      "script": "generators/bubbleGrid.js",
      "export": "generate"
    }
  }
}
