[
  {
    "id": "tap_column",
    "name": "Tap any column",
    "trigger": { "type": "tap", "target": "selector" },
    "conditions": [
      { "type": "expression", "expr": "!stateIs('turnFlow', 'gameOver')" }
    ],
    "actions": [
      { "type": "run_script", "script": "scripts/game.js", "export": "handleColumnTap" }
    ]
  },
  {
    "id": "check_win_after_drop",
    "name": "Check for win after disc drop",
    "trigger": { "type": "event", "eventName": "disc_dropped" },
    "actions": [
      { "type": "run_script", "script": "scripts/game.js", "export": "checkWin" }
    ]
  }
]
