[
  {
    "id": "spin_on_tap",
    "name": "Spin on tap",
    "trigger": { "type": "tap" },
    "conditions": [{ "type": "expression", "expr": "variable('isSpinning') === 0" }],
    "actions": [
      { "type": "set_variable", "name": "isSpinning", "operation": "set", "value": 1 },
      { "type": "event", "eventName": "spin" }
    ]
  }
]
