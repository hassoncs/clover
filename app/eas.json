{
	"cli": {
		"version": ">= 12.0.0",
		"appVersionSource": "local"
	},
	"build": {
		"base": {
			"node": "20.18.0",
			"pnpm": "9.0.0",
			"env": {
				"EXPO_PUBLIC_EMBED_GAMES": "true"
			}
		},
		"production": {
			"extends": "base",
			"channel": "production",
			"distribution": "store",
			"ios": {
				"resourceClass": "m-medium"
			}
		},
		"preview": {
			"extends": "base",
			"channel": "preview",
			"distribution": "internal",
			"ios": {
				"simulator": true
			}
		},
		"development": {
			"extends": "base",
			"env": {
				"EXPO_PUBLIC_EMBED_GAMES": "false"
			}
		},
		"amen-development": {
			"extends": "development",
			"env": {
				"BRAND_ID": "amen"
			}
		},
		"amen-preview": {
			"extends": "preview",
			"env": {
				"BRAND_ID": "amen"
			}
		},
		"amen-production": {
			"extends": "production",
			"env": {
				"BRAND_ID": "amen"
			}
		}
	},
	"submit": {
		"production": {
			"ios": {
				"appleId": "hassoncs@gmail.com",
				"ascAppId": "6741757827",
				"appleTeamId": "73G23Y42T6"
			}
		},
		"amen-production": {
			"ios": {
				"appleId": "hassoncs@gmail.com",
				"appleTeamId": "73G23Y42T6"
			}
		}
	}
}
