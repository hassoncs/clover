{
	"id": "gambling-economy",
	"description": "Probabilistic gate economy. Tests RNG-seeded distribution through slot machine with win/lose paths.",
	"resourceTypes": ["coins"],
	"nodes": [
		{
			"id": "coin-press",
			"type": "source",
			"label": "Coin Press",
			"resourceType": "coins"
		},
		{
			"id": "wallet",
			"type": "pool",
			"label": "Wallet",
			"resourceType": "coins",
			"capacity": 200,
			"initialValue": 0
		},
		{
			"id": "slot-machine",
			"type": "gate",
			"label": "Slot Machine",
			"resourceType": "coins",
			"mode": "probabilistic"
		},
		{
			"id": "jackpot",
			"type": "pool",
			"label": "Jackpot",
			"resourceType": "coins",
			"capacity": 500,
			"initialValue": 0
		},
		{
			"id": "house",
			"type": "pool",
			"label": "House",
			"resourceType": "coins"
		},
		{
			"id": "tax",
			"type": "drain",
			"label": "Tax",
			"resourceType": "coins"
		}
	],
	"edges": [
		{
			"id": "mint",
			"type": "resource",
			"from": "coin-press",
			"to": "wallet",
			"formula": "10"
		},
		{
			"id": "bet",
			"type": "resource",
			"from": "wallet",
			"to": "slot-machine",
			"formula": "5"
		},
		{
			"id": "win",
			"type": "resource",
			"from": "slot-machine",
			"to": "jackpot",
			"probability": 0.3
		},
		{
			"id": "lose",
			"type": "resource",
			"from": "slot-machine",
			"to": "house",
			"probability": 0.7
		},
		{
			"id": "house-tax",
			"type": "resource",
			"from": "house",
			"to": "tax",
			"formula": "1"
		}
	],
	"expectedBehavior": {
		"seed": 31415,
		"ticks": 50,
		"assertions": {
			"bothPathsReceiveCoins": true,
			"gateRoutedEventsEmitted": true,
			"deterministic": true,
			"differentSeedsDifferentResults": true
		}
	}
}
