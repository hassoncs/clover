{
	"task": "T5 - Error handling patterns for design tool contracts",
	"errorResponses": {
		"readDesignDocument": {
			"notFound": { "ok": false, "error": "not found" },
			"parseFailure": {
				"ok": false,
				"error": "Invalid design document schema: ..."
			}
		},
		"updateDesignElement": {
			"notFound": { "ok": false, "error": "not found" },
			"frameNotFound": {
				"ok": false,
				"error": "element not found: <elementId>"
			},
			"elementNotFound": {
				"ok": false,
				"error": "element not found: <elementId>"
			},
			"schemaValidationFailure": {
				"ok": false,
				"error": "schema validation failed: <reason>"
			}
		},
		"addDesignFrame": {
			"notFound": { "ok": false, "error": "not found" },
			"parseFailure": {
				"ok": false,
				"error": "schema validation failed: <reason>"
			}
		},
		"getDesignSelectionContext": {
			"editorNotConnected": {
				"selectedFrameId": null,
				"selectedElementId": null
			}
		}
	},
	"successResponses": {
		"readDesignDocument": { "ok": true, "document": "<DesignDocument>" },
		"updateDesignElement": {
			"ok": true,
			"diff": { "elementId": "<id>", "changes": { "fill": "#ff0000" } }
		},
		"addDesignFrame": { "ok": true, "frameId": "<nanoid>" },
		"getDesignSelectionContext": {
			"selectedFrameId": "<id>",
			"selectedElementId": "<id>"
		}
	},
	"guardrails": [
		"No raw error stack traces - all errors are sanitized strings",
		"Schema validation via DesignDocumentSchema.safeParse() before every write",
		"Structured ok/error discriminated union on all tool outputs",
		"Uses parseDesignDocument() from @slopcade/shared for consistent validation"
	]
}
